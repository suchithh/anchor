# Copy to .env in this extension's root. The extension loads it on each request.
# .env is Git-ignored; keep permissions owner-only (chmod 600 .env).
TYPESAFE_API_KEY=
PI_GRAIL_JEV_MODEL=jev-latest
# Optional API root, without /v1; defaults to https://api.typesafe.ai.
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# Optional key-file override; otherwise ~/.pi/agent/secrets/typesafe_api_key.
# PI_GRAIL_API_KEY_FILE=/absolute/path/to/key
PI_GRAIL_GROUNDING_URL=http://127.0.0.1:8000
PI_GRAIL_CORPUS_ID=http_rfc
PI_GRAIL_GROUNDING_ENABLED=true
PI_GRAIL_GROUNDING_TIMEOUT_MS=15000
DEMO_MODE=true
