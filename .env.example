MONGODB_URI=
MONGODB_DB=grounding_harness
MONGODB_TIMEOUT_MS=30000
OPENROUTER_API_KEY=
VOYAGE_API_KEY=
JEV_MODEL=typesafe/jev-1.13
BASELINE_MODEL=
BASELINE_REASONING=false
# Default integration judge; set jev for the typed probabilistic verifier.
VERIFIER=llm
VOYAGE_MODEL=voyage-3.5-lite
EMBEDDING_DIMENSIONS=1024
VECTOR_INDEX_NAME=grounding_vector
SEARCH_INDEX_NAME=grounding_text
TOP_K=3
MAX_CONCURRENCY=8
GROUNDING_ALPHA=0.8
RETRIEVAL_MODE=vector
RERANKER=none
VOYAGE_RERANK_MODEL=rerank-2.5-lite
# Optional explicit prices; blank means cost unavailable, NOT zero.
VOYAGE_USD_PER_MILLION_TOKENS=
VOYAGE_RERANK_USD_PER_MILLION_TOKENS=
# Conservative UTF-8 byte budget, NOT a claimed model token count.
POSTHOC_MAX_INPUT_BYTES=60000
HTTP_TIMEOUT_SECONDS=90
